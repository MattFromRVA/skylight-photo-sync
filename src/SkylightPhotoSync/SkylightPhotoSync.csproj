<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SkylightPhotoSync</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>skylight-sync</ToolCommandName>
    <PackageId>SkylightPhotoSync</PackageId>
    <Version>0.1.0</Version>
    <Description>Emails new Amazon Photos to a Skylight Calendar on a Mac schedule.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MattFromRVA/skylight-photo-sync</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkylightPhotoSync.Tests" />
  </ItemGroup>

</Project>
